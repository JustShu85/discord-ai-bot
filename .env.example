# Copy this file to ".env" and fill in your own values.
# NEVER commit or share your real .env file.

# Required
DISCORD_TOKEN=your_discord_bot_token
GEMINI_API_KEY=your_gemini_api_key

# Models, comma-separated. If the first is busy, the next is tried.
# The startup log prints the models your key can use.
GEMINI_MODELS=gemini-3.8-flash

# Persona file to load (see the personas/ folder)
PERSONA_FILE=personas/shorekeeper.md

# Optional: the name the bot calls the server owner
OWNER_NAME=

# Optional: only these Discord user IDs can use the bot (comma-separated).
# Leave empty to allow everyone who mentions the bot.
ALLOWED_USER_IDS=
